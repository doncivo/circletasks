# Fins de ligne normalisées en LF dans le dépôt (Windows et runners macOS)
* text=auto eol=lf

# Scripts Windows : CRLF obligatoire
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binaires
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.icns binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.wasm binary
*.db binary
*.sqlite binary
*.ipa binary
*.zip binary
*.pdf binary
